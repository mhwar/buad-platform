{
  // One Worker serves both the API (/api/*) and the built web app (static assets, SPA fallback).
  // Same origin => the session cookie just works, and any custom domain can be attached to this Worker.
  "name": "buad-v2",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_VERSION": "0.0.0" },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /site* runs the Worker first only to add link-preview tags; static files pass straight through.
    "run_worker_first": ["/api/*", "/site", "/site/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buad-v2",
      "database_id": "33b6bb7c-c22c-4796-892a-ac0e94a024d2",
      "migrations_dir": "migrations"
    }
  ],
  // Uploaded files (organisation logo, stamp, signature, letterheads, document images).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "buad-v2-files" }],
  // Headless Chrome (Browser Run) for real vector PDFs of documents and reports.
  "browser": { "binding": "BROWSER" },
  // Sign-in attempts: at most 10 a minute from one address.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Logs and errors kept in Cloudflare (Workers Logs), to see and alert on failures in production.
  "observability": { "enabled": true }
  // Secret (never in this file): wrangler secret put JWT_SECRET
}
